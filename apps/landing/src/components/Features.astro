---
const features = [
  {
    title: 'Test Across Your Whole Stack',
    description: 'Drive a real browser, hit real services, query real databases, and mock external APIs, all in one test. Assert on what the user sees and what your backend does.',
    color: '#0ea5e9',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
  },
  {
    title: 'Assert on What You Can\'t See',
    description: 'Intercept every HTTP call between services. Inspect database queries. Mock external APIs like Stripe and Auth0 with controlled responses. Assert on the traffic other tools never capture.',
    color: '#fbbf24',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>',
  },
  {
    title: 'Scale the Environment to the Test',
    description: 'Define only what you need. One service and a mock, or your full stack with seeded databases. Seed Postgres, MySQL, MongoDB, or Redis with custom data. Every test gets its own isolated namespace.',
    color: '#34d399',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>',
  },
  {
    title: 'Built for AI',
    description: 'Ships with a full MCP server. Your AI agent can write, validate, run, and debug tests directly. YAML/JSON definitions and structured output mean agents work with Dokkimi natively.',
    color: '#a78bfa',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8" y2="16"/><line x1="16" y1="16" x2="16" y2="16"/><path d="M9 7L5 11"/><path d="M15 7l4 4"/></svg>',
  },
];
---

<section id="features" class="features">
  <div class="container">
    <h2 class="section-heading reveal">Why Dokkimi?</h2>
    <p class="section-subtitle reveal">
      Your existing tests are great at what they do.
      Dokkimi tests the parts they were never built to reach.
    </p>
    <div class="grid reveal-group">
      {features.map((f) => (
        <div class="card reveal" style={`--card-color: ${f.color};`}>
          <div class="card-header">
            <div class="card-icon" set:html={f.icon} />
            <h3>{f.title}</h3>
          </div>
          <p>{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding: var(--section-spacing) 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .card {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--card-color);
    border-radius: 12px;
    padding: 32px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3), 0 0 20px color-mix(in srgb, var(--card-color) 15%, transparent);
    border-color: color-mix(in srgb, var(--card-color) 40%, var(--color-border));
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .card-icon {
    flex-shrink: 0;
    display: flex;
    color: var(--card-color);
  }

  .card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--card-color);
  }

  .card p {
    font-size: 0.925rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
