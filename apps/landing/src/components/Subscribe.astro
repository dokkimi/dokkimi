---

---

<section id="subscribe" class="subscribe">
  <div class="container">
    <h2 class="section-heading">Stay in the loop</h2>
    <p class="section-subtitle">
      New features, tutorials, and tips every two weeks. No spam.
    </p>
    <div class="subscribe-form-container" id="newsletter-form-container">
      <form
        action="https://app.loops.so/api/newsletter-form/cmtngnrxk01un0jzqt64wm72v"
        method="POST"
        class="subscribe-form"
        id="newsletter-form"
      >
        <input
          type="email"
          name="newsletter-form-input"
          placeholder="Enter your email"
          required
          class="subscribe-input"
        />
        <button type="submit" class="subscribe-button">Subscribe</button>
        <button type="button" class="subscribe-loading" style="display:none">Please wait...</button>
      </form>
      <p class="subscribe-success" style="display:none">Thanks! We'll be in touch!</p>
      <p class="subscribe-error" style="display:none">Oops! Something went wrong, please try again</p>
      <button type="button" class="subscribe-back" style="display:none">&larr; Back</button>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var container = document.getElementById('newsletter-form-container');
    if (!container) return;

    var form = container.querySelector('#newsletter-form');
    var input = container.querySelector('.subscribe-input');
    var submitBtn = container.querySelector('.subscribe-button');
    var loadingBtn = container.querySelector('.subscribe-loading');
    var success = container.querySelector('.subscribe-success');
    var error = container.querySelector('.subscribe-error');
    var backBtn = container.querySelector('.subscribe-back');

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      // GA4 event
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'newsletter_subscribe',
        form_location: 'subscribe_section',
      });

      // Rate limit: 1 signup per minute
      var now = Date.now();
      var prev = localStorage.getItem('loops-form-timestamp');
      if (prev && Number(prev) + 60000 > now) {
        error.textContent = 'Too many signups, please try again in a little while';
        error.style.display = 'block';
        submitBtn.style.display = 'none';
        input.style.display = 'none';
        backBtn.style.display = 'inline-block';
        return;
      }
      localStorage.setItem('loops-form-timestamp', now);

      submitBtn.style.display = 'none';
      loadingBtn.style.display = 'inline-flex';

      var body = 'userGroup=&mailingLists=&email=' + encodeURIComponent(input.value);

      fetch(form.action, {
        method: 'POST',
        body: body,
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      })
        .then(function (res) {
          if (res.ok) {
            success.style.display = 'block';
            form.reset();
          } else {
            res.json().then(function (data) {
              error.textContent = data.message || res.statusText;
              error.style.display = 'block';
            });
          }
        })
        .catch(function (err) {
          if (err.message === 'Failed to fetch') {
            error.textContent = 'Too many signups, please try again in a little while';
          } else if (err.message) {
            error.textContent = err.message;
          }
          error.style.display = 'block';
          localStorage.setItem('loops-form-timestamp', '');
        })
        .finally(function () {
          input.style.display = 'none';
          loadingBtn.style.display = 'none';
          backBtn.style.display = 'inline-block';
        });
    });

    backBtn.addEventListener('click', function () {
      success.style.display = 'none';
      error.style.display = 'none';
      error.textContent = 'Oops! Something went wrong, please try again';
      backBtn.style.display = 'none';
      input.style.display = 'block';
      submitBtn.style.display = 'inline-flex';
    });
  })();
</script>

<style>
  .subscribe {
    padding: var(--section-spacing) 0;
  }

  .subscribe-form-container {
    max-width: 440px;
    margin: 0 auto;
    text-align: center;
  }

  .subscribe-form {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .subscribe-input {
    flex: 1;
    padding: 12px 16px;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.925rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .subscribe-input::placeholder {
    color: var(--color-text-muted);
  }

  .subscribe-input:focus {
    border-color: var(--color-primary);
  }

  .subscribe-button,
  .subscribe-loading {
    padding: 12px 24px;
    background: var(--color-primary);
    border: 1px solid var(--color-primary);
    border-radius: 8px;
    color: white;
    font-family: var(--font-sans);
    font-size: 0.925rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    white-space: nowrap;
    align-items: center;
    justify-content: center;
  }

  .subscribe-button:hover {
    background: var(--color-primary-soft);
    border-color: var(--color-primary-soft);
  }

  .subscribe-loading {
    cursor: default;
    opacity: 0.7;
  }

  .subscribe-success {
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-size: 0.925rem;
    margin-top: 8px;
  }

  .subscribe-error {
    color: #ef4444;
    font-family: var(--font-sans);
    font-size: 0.925rem;
    margin-top: 8px;
  }

  .subscribe-back {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    cursor: pointer;
    margin-top: 8px;
  }

  .subscribe-back:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .subscribe-form {
      flex-direction: column;
    }
  }
</style>
